# ---- C++ / CMake ----
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
compile_commands.json
*.o
*.a
*.so
*.dylib

# ---- Python ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Run artifacts ----
# Simulation output is regenerated from config; it is a build product, not source.
data/*
!data/.gitkeep
!data/samples/
*.log

# ---- Media ----
# Video is fetched by scripts/, never committed. See docs/conventions.md.
*.mp4
*.mov
*.avi

# ---- Secrets ----
# Nothing in this project requires credentials. These patterns exist so that an
# accidental commit is impossible rather than merely unlikely: the repository is
# public, and a secret pushed once must be treated as compromised even if the
# commit is later removed.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
credentials
credentials.*
secrets.*
.netrc

# ---- Editors / OS ----
.DS_Store
.idea/
.vscode/
*.swp
